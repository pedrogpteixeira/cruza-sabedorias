{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "cruza-sabedorias": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "prefix": "cs",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "outputPath": "dist/cruza-sabedorias",
            "index": "src/index.html",
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "assets": [{ "glob": "**/*", "input": "public" }],
            "styles": ["src/styles.css"]
          },
          "configurations": {
            "production": {
              "budgets": [
                { "type": "initial", "maximumWarning": "600kB", "maximumError": "1MB" },
                { "type": "anyComponentStyle", "maximumWarning": "8kB", "maximumError": "15kB" }
              ],
              "outputHashing": "all",
              "optimization": { "scripts": true, "styles": true, "fonts": false }
            },
            "development": { "optimization": false, "extractLicenses": false, "sourceMap": true }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "production": { "buildTarget": "cruza-sabedorias:build:production" },
            "development": { "buildTarget": "cruza-sabedorias:build:development" }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  },
  "cli": { "analytics": false }
}
